<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_primate_ai" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.primate.ai</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Primate IA" string="Primate IA" name="primate_ai" groups="base.group_system">
          <block title="Claude (Anthropic)" name="primate_ai_block">
            <setting string="API key" help="Tu API key de Anthropic (se guarda en ir.config_parameter).">
              <field name="primate_ai_api_key" password="True"/>
            </setting>
            <setting string="Modelo (análisis)" help="Modelo para análisis/documentación. Recomendado: claude-sonnet-4-6.">
              <field name="primate_ai_model"/>
            </setting>
            <setting string="Modelo rápido" help="Modelo barato para consultas simples (tiering). Sagui lo usa para preguntas cortas.">
              <field name="primate_ai_model_fast"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
