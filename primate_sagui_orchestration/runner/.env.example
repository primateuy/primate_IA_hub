# Copiá a .env y completá. El runner lo carga automáticamente (no pisa variables ya seteadas).
SAGUI_URL=http://localhost:8069
# Pegá el token que configuraste en Odoo (ir.config_parameter 'sagui.runner_token'). NO lo commitees.
SAGUI_TOKEN=cambiame-por-tu-token
POLL_INTERVAL=10
CLAUDE_BIN=claude
# permission mode no interactivo para correr desatendido (acceptEdits | bypassPermissions | plan | default)
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_TIMEOUT=1200
# timeout (seg) para el paso VERIFY (correr tests_cmd del job fix)
TESTS_TIMEOUT=600
