# --- Conexión Odoo ---
# URL del servidor (sin / al final). Local: http://localhost:8088. Online: https://www.primate.uy
ODOO_URL=http://localhost:8088

# Nombre de la base de datos
ODOO_DB=o17_forum_staging

# Usuario (recomendado: crear uno dedicado tipo "claude_bot" con permisos de solo lectura)
ODOO_USERNAME=soporteforum@primate.uy

# API key del usuario (NO la contraseña). Generar en: Preferencias -> Cuenta -> Claves API
ODOO_API_KEY=dd051a4993a7776f64f042e5a9079944acac10c0

# --- Transporte MCP ---
# stdio  -> usar con Claude Code (modo subproceso, default)
# sse    -> usar con Claude.ai como custom connector remoto (HTTP)
MCP_TRANSPORT=stdio

# Solo aplica si MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8765
