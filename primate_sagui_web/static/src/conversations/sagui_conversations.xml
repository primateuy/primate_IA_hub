<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="primate_sagui_web.SaguiConversations">
    <div class="o_sagui_convs">

      <!-- Panel izquierdo: lista de conversaciones -->
      <aside class="o_sagui_convlist">
        <button class="o_sagui_newconv" type="button" t-on-click="() => this.newConversation()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          <span>Nueva conversación</span>
        </button>
        <div class="o_sagui_convitems">
          <t t-if="!state.list.length">
            <div class="o_sagui_convempty">Todavía no tenés conversaciones.</div>
          </t>
          <t t-foreach="state.list" t-as="c" t-key="c.id">
            <div class="o_sagui_convitem" t-att-class="{ 'o-active': state.currentId === c.id }"
                 t-on-click="() => this.selectConversation(c.id)">
              <div class="o_sagui_convmeta">
                <div class="t" t-esc="c.name"/>
                <div class="d" t-esc="fmtDate(c.last_activity)"/>
              </div>
              <button class="o_sagui_convdel" type="button" title="Borrar"
                      t-on-click="(ev) => this.removeConversation(ev, c.id, c.name)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                </svg>
              </button>
            </div>
          </t>
        </div>
      </aside>

      <!-- Panel derecho: chat de la conversación seleccionada (remonta por t-key al alternar) -->
      <div class="o_sagui_convchat">
        <t t-if="state.currentId">
          <SaguiChat t-key="state.currentId" conversationId="state.currentId"
                     onActivity="() => this.onActivity()"/>
        </t>
        <t t-else="">
          <div class="o_sagui_convplaceholder">
            Elegí una conversación a la izquierda, o creá una nueva para empezar a chatear con Sagui.
          </div>
        </t>
      </div>
    </div>
  </t>
</templates>
