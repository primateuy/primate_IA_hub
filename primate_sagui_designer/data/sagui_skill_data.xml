    <!--
        REGISTROS DE COMPOSICIÓN. Un registro dice cómo se COMPONE una página -hero, ritmo,
        densidad, tipo de imagen, presupuesto de movimiento, forma del footer-, nunca qué colores
        usa. El README es el que manda el mapeo por defecto y la regla de que un registro no
        aporta paleta, tipografía ni firma; los tres archivos son los registros disponibles.
        Se cargan como `reference` porque el agente los CONSULTA al elegir, no los ejecuta paso
        a paso.
    -->

    <record id="skill_registers_readme" model="sagui.skill">
        <field name="name">Registros de composición — cómo se elige y qué NO aporta un registro</field>
        <field name="key">registers</field>
        <field name="kind">reference</field>
        <field name="sequence">31</field>
        <field name="source_path">primate_sagui_designer/skills/_shared/registers/README.md</field>
